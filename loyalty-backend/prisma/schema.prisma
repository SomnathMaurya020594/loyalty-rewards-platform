generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                Int      @id @default(autoincrement())
  shopifyCustomerId String?  @unique
  name              String
  email          String   @unique
  currentPoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  redeemedPoints Int      @default(0)
  totalSpent        Float    @default(0) 
  tier              String   @default("Bronze")
  tierLocked        Boolean  @default(false)  
  createdAt      DateTime @default(now())
  transactions   Transaction[]
  redemptions    RewardRedemption[]
}

model Tier {
  id        Int      @id @default(autoincrement())
  name      String   // e.g. "Bronze", "Silver", "Gold", "Platinum" — merchant decides the name
  minPoints Int      // lifetime points needed to reach this tier
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model LoyaltyRule {
  id       Int      @id @default(autoincrement())
  name     String
  points   Int
  isActive Boolean  @default(true)
}
model Reward {
  id               Int      @id @default(autoincrement())
  name             String
  type             String
  shopifyProductId String?
  discountValue Float?
  pointsCost       Int
  isActive         Boolean  @default(true)

  redemptions RewardRedemption[]
}

model Transaction {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  type       String
  points     Int
  note       String
  createdAt  DateTime @default(now())
}

model RewardRedemption {
  id            Int      @id @default(autoincrement())
  customerId    Int
  customer      Customer @relation(fields: [customerId], references: [id])
  rewardId      Int
  reward        Reward   @relation(fields: [rewardId], references: [id])
  pointsSpent   Int
  generatedCode String
  status        String   @default("PENDING") // PENDING -> APPLIED (confirmed via orders/paid webhook)
  orderId       String?
  createdAt     DateTime @default(now())
}
model ActivityLog {
  id        Int      @id @default(autoincrement())
  type      String
  event     String
  detail    String?
  createdAt DateTime @default(now())
}